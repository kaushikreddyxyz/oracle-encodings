+# Stage-7 oracle coord injection: load the FIXED orthonormal P and register it as
+# a non-trainable buffer (so it is untouched by the optimizer / weight decay and
+# excluded from the param-group partition), and stamp the injection config onto
+# the model. Done AFTER init_weights + no_value_embeds and BEFORE torch.compile so
+# the buffer is captured in the graph. Absent => vanilla forward (coords stays None).
+coord_source = None
+if args.inject_coords:
+    import numpy as np, json, sys, os
+    sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "..",
+                    "concept_probes", "stage7_oracle", "code", "nanochat_patch"))
+    from coords_store import CoordSource
+    P = np.load(os.path.join(args.inject_coords, "P.npy"))            # (n_embd, r)
+    assert P.shape[0] == model.config.n_embd, (P.shape, model.config.n_embd)
+    model.register_buffer("inject_P", torch.from_numpy(P).to(device), persistent=False)
+    model.inject_after_block = int(args.inject_after_block)
+    model.inject_beta = float(args.inject_beta)
+    coord_source = CoordSource(args.inject_coords, device=device,
+                               noise_sigma=args.inject_noise_sigma, seed=args.seed)
+    print0(f"--inject-coords: r={coord_source.r} after_block={args.inject_after_block} "
+           f"beta={args.inject_beta} noise={args.inject_noise_sigma} P={P.shape}")
+
